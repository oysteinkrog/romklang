[Unit]
Description=romklang convolver (virtual surround and headphone EQ)
Documentation=https://github.com/oysteinkrog/romklang
After=pipewire.service
BindsTo=pipewire.service

[Service]
# Starts romklang@a or romklang@b, whichever slot is current. Those units are
# PartOf this one, so stopping or restarting this one does the same to them.
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/romklang start
Slice=session.slice

[Install]
WantedBy=pipewire.service
